DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/barbarito
SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO
JWT_SECRET_KEY=REEMPLAZAR_POR_OTRO_SECRETO_ALEATORIO
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Production: mount a persistent volume at /data and set APP_DATA_DIR=/data.
# Leave unset locally to preserve backend/instance.
# APP_DATA_DIR=/data
# Optional origin allowlist when frontend and backend have separate domains.
# Same-origin Docker deployment uses CORS_ORIGINS="".
# CORS_ORIGINS=https://tu-frontend.example

# Optional: model for bounded language interpretation only. Empty uses OPENAI_MODEL.
OPENAI_ROUTER_MODEL=


# Administrative LOCAL URL used only by scripts/migrate_customers.py, never by HTTP.
DATABASE_MIGRATION_URL=

# Optional Factiliza free account token. Server-side only; no automatic paid plan.
FACTILIZA_TOKEN=

# Private Laravel fact_api bridge; demo only, never SUNAT production.
FACT_API_URL=http://127.0.0.1:8091
FACT_API_TOKEN=
FACT_API_MODE=DEMO
FACT_API_MIN_WORKERS=1
FACT_API_MAX_WORKERS=4
# Optional persistent private directory; defaults to instance/fact_api_documents.
# FACT_API_DOCUMENTS_DIR=/data/fact_api_documents
CORPORATE_EMAIL_DOMAIN=barbarian.pe

# Entrada de integraciones: token privado aleatorio (32 caracteres o mas) y local de destino.
INTEGRACIONES_API_TOKEN=
INTEGRACIONES_API_LOCAL=
INTEGRACIONES_API_ORIGEN="Sistema externo"

# Clave de lectura emitida por AcadeSys
ACADESYS_API_TOKEN=

# Opcional: reemplaza los valores de integraciones de app/modules/integraciones/settings.json.
# ACADESYS_API_HOST=acadesys-api.onrender.com
# INTEGRACIONES_CONSULTA_INTENTOS=3
# INTEGRACIONES_REINTENTO_SEGUNDOS=30
# INTEGRACIONES_LECTURA_POR_MINUTO=60
# INTEGRACIONES_VIGENCIA_DIAS=30
# INTEGRACIONES_VIGENCIA_MAX_DIAS=365
# INTEGRACIONES_CREDENCIAL_TTL_SEGUNDOS=86400
# INTEGRACIONES_HTTP_TIMEOUT_SEGUNDOS=8
# INTEGRACIONES_HTTP_PLAZO_SEGUNDOS=12
# INTEGRACIONES_HTTP_MAX_BYTES=524288
# INTEGRACIONES_HTTP_MAX_REGISTROS=200
